# Default line ending handling (auto normalize to LF in repository)
* text=auto

# Docker, shell, and entrypoint files must always use LF
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.sh text eol=lf

# Lua and web template source files
*.lua text eol=lf
*.html text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.md text eol=lf

# Binary / image files (do not touch line endings)
*.jpeg binary
*.jpg binary
*.png binary
*.ico binary